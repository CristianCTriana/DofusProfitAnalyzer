# Configuración del proyecto Firebase (Auth + Firestore).
# Copia este archivo a .env.local y completa con los valores de tu proyecto
# en https://console.firebase.google.com -> Configuración del proyecto.
# .env.local nunca se sube a git (ver .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
